# Copy to .env.local for local development. Never commit .env.local.
#
# Both values are public by design (they ship to the browser). They come from
# Supabase → Project Settings → API. Do NOT put the service_role / secret key
# in any variable whose name starts with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
