    {
      "id": "there-is",
      "title": "There is … / There isn't … / Is there …?",
      "template": "{word} {ending}",
      "template_script": "{word} {ending}",
      "explanation": "ide means \"there is\" or \"it's here\", illa means \"there isn't\". Add a long ā to ide and it becomes a yes-or-no question: ideyā? No word for \"is\" or \"there\" is needed before it.",
      "sources": [
        "SWALPA-logistics",
        "SWALPA-survival"
      ],
      "endings": [
        {
          "id": "statement",
          "label": "There is",
          "roman": "ide",
          "script": "ಇದೆ",
          "english": "There is {word}"
        },
        {
          "id": "negative",
          "label": "There isn't",
          "roman": "illa",
          "script": "ಇಲ್ಲ",
          "english": "There is no {word}"
        },
        {
          "id": "question",
          "label": "Is there?",
          "roman": "ideyā?",
          "script": "ಇದೆಯಾ?",
          "english": "Is there {word}?"
        }
      ],
      "words": [
        {
          "word": "water",
          "english": "water"
        },
        {
          "word": "power",
          "english": "power"
        },
        {
          "word": "coffee",
          "english": "coffee"
        },
        {
          "word": "tea",
          "english": "tea"
        }
      ]
    },
    {
      "id": "please-give",
      "title": "Please give …",
      "template": "{word} {ending}",
      "template_script": "{word} {ending}",
      "explanation": "koDi is the polite \"give\". Adding -i to a verb makes a polite request, right for waiters, shopkeepers and anyone you don't know well. Name the thing first, then koDi.",
      "sources": [
        "SWALPA-survival"
      ],
      "endings": [
        {
          "id": "statement",
          "label": "Please give",
          "roman": "koDi",
          "script": "ಕೊಡಿ",
          "english": "Please give me {word}"
        }
      ],
