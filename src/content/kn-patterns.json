    {
      "id": "know",
      "title": "I know … / I don't know …",
      "template": "nanage {word} {ending}",
      "template_script": "ನನಗೆ {word} {ending}",
      "explanation": "Same shape as bēku: \"to me, Kannada is known\". The knower takes nanage (to me), the language stays as it is, and gottu (known) comes last. gottilla is gottu + illa, \"not known\".",
      "sources": [
        "Penn",
        "Goethe"
      ],
      "endings": [
        {
          "id": "statement",
          "label": "Know",
          "roman": "gottu",
          "script": "ಗೊತ್ತು",
          "english": "I know {word}"
        },
        {
          "id": "negative",
          "label": "Don't know",
          "roman": "gottilla",
          "script": "ಗೊತ್ತಿಲ್ಲ",
          "english": "I don't know {word}"
        }
      ],
