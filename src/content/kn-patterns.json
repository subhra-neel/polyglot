    {
      "id": "how-much",
      "title": "How much is …?",
      "template": "{word} {ending}",
      "template_script": "{word} {ending}",
      "explanation": "eshTu means \"how much\". It comes after the thing you are asking about, the opposite of English: \"rent how much?\"",
      "sources": [
        "SWALPA-logistics"
      ],
      "endings": [
        {
          "id": "question",
          "label": "How much?",
          "roman": "eshTu?",
          "script": "ಎಷ್ಟು?",
          "english": "How much is {word}?"
        }
