  "patterns": [
    {
      "id": "want",
      "title": "I want … / I don't want …",
      "template": "nanage {word} {ending}",
      "template_script": "ನನಗೆ {word} {ending}",
      "explanation": "Kannada says \"to me, water is wanted\". The person who wants takes the \"to\" form: nānu (I) becomes nanage (to me). The thing wanted stays as it is, and bēku comes last. Swap bēku for bēDa to say you don't want it.",
      "note": "In quick speech nanage often shortens to nange.",
      "sources": [
        "SWALPA-survival"
      ],
      "endings": [
        {
          "id": "statement",
          "label": "Want",
          "roman": "bēku",
          "script": "ಬೇಕು",
          "english": "I want {word}"
        },
        {
          "id": "negative",
          "label": "Don't want",
          "roman": "bēDa",
          "script": "ಬೇಡ",
          "english": "I don't want {word}"
        }
      ],
      "words": [
        {
          "word": "water",
          "english": "water"
